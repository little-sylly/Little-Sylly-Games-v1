# What Cloudflare must NOT upload as static assets (gitignore syntax). The app is
# index.html, sw.js, manifest.json, assets/, css/, fonts/, js/ and data/ — everything
# else is repo tooling. Adding a runtime folder? Don't list it here; this is a deny-list.

# The repo itself (the 115 MiB pack file that broke the 20 Oct 2026 deploy)
.git
.githooks
.gitattributes
.gitignore

# Tooling, agents and docs — never fetched by the app
.claude
.impeccable
.superpowers
docs
tools
src
wip
node_modules

# Root docs and config
CLAUDE.md
DESIGN.md
PRODUCT.md
LICENSE
wrangler.jsonc
.assetsignore

# Inside the shipped folders: workshop notes, briefs and the bench, never loaded
js/arcade/_archive
js/arcade/briefs
js/arcade/*.md
data/sticker-masters
